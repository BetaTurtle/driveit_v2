#!/bin/sh

# Check if landing.html is being committed
if git diff --cached --name-only | grep -q "^landing.html$"; then
    echo "landing.html modified. Bumping version..."
    
    # Run the bumper script
    python3 scripts/bump_version.py
    
    # If the script succeeded, add the file back to the staging area
    if [ $? -eq 0 ]; then
        git add landing.html
    else
        echo "Version bump failed."
        exit 1
    fi
fi

exit 0
